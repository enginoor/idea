# Swift Package Manager
.build/
.swiftpm/

# Xcode
DerivedData/
*.xcodeproj/xcuserdata/
*.xcodeproj/project.xcworkspace/xcuserdata/
*.xcuserstate
xcuserdata/
*.xcscmblueprint

# macOS
.DS_Store

# App-specific
*.xcworkspace/xcuserdata/

# Release build outputs (Scripts/package-app.sh, make-dmg.sh, ...)
build/
*.dmg

# Python caches
__pycache__/
*.pyc

# Sparkle signing secrets. The public key (Sparkle/public-key.txt) is
# committed on purpose; private keys and exports must never be.
Sparkle/*.pem
Sparkle/private-key*
Sparkle/*-export*

# Core dumps from crash repros in the sandbox
core
